DATABASE_URL=postgresql://filinglens:filinglens@localhost:5432/filinglens
SEC_USER_AGENT="FilingLens Your Name your@email.com"
SNAPSHOT_ID=2026-10-19-v1
INGESTION_CUTOFF=2026-10-19
SEC_REQUESTS_PER_SECOND=8
SEC_MAX_ATTEMPTS=5
# Optional local database overrides (keep DATABASE_URL consistent).
POSTGRES_PORT=5432
POSTGRES_PASSWORD=filinglens
# M4 agent runtime (live runs only; never passed to MCP servers).
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
# Model IDs come only from these variables. PLANNER_MODEL is the large-model slot
# used by the planner and the analyst; WORKER_MODEL by the filings (and optional
# LLM data) worker; VERIFIER_MODEL by the verifier. Each needs an entry in
# filinglens/llm/pricing.toml.
PLANNER_MODEL=
WORKER_MODEL=
VERIFIER_MODEL=
# Optional per-run dollar cap (decimal); unset means only MAX_RUN_TOKENS applies.
MAX_RUN_COST_USD=
BASELINE_MODELS=
OPEN_MODEL=
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVAL_CORPUS=corpus_3f3c2a9affddcc6a29eca9e768c65bcbd3e2f131fb69595b24b9b92005738739
# M3 server configuration; mode is not a tool argument.
RETRIEVAL_MODE=vector
MAX_RUN_TOKENS=200000
EVAL_CONCURRENCY=4
